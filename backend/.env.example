# Copy this file to .env (or set these as real environment variables on
# your hosting platform) and adjust as needed. main.py reads these via
# config.py — nothing is hardcoded in the source.

HOST=0.0.0.0
PORT=8000
DEBUG=false

# Comma-separated list of frontend origins allowed to call this API.
# Add your deployed frontend URL(s) here in production.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

DEFAULT_CONFIDENCE_THRESHOLD=0.5
MAX_UPLOAD_SIZE_MB=8
MAX_FRAME_DIMENSION=1920

SESSION_TTL_SECONDS=600
TRACKER_MAX_MISSED_FRAMES=15
TRACKER_IOU_THRESHOLD=0.3
ANALYTICS_HISTORY_MAXLEN=300
